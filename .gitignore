# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments and local env files
.venv/
.venv*/
.env
.env.local
.env.*.local

# Build output
build/
dist/
deployment/
*.spec
!pysidedeploy.spec
nuitka-crash-report.xml

# Tool caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.nox/
.coverage
.coverage.*
coverage.xml

# Editors
.vscode/
.idea/
.vs/

# Logs and local run output
*.log
logs/
artifacts/
/tmp/
/output/
/screenshots/

# Local databases: keep the folder, never its contents
database/*
!database/.gitkeep

# Knowledge graph and agent tooling, regenerated locally
.graphify/
graphify-out/
.codex/
.claude/
.serena/

# Patch leftovers and OS files
*.orig
*.rej
.DS_Store
Thumbs.db
desktop.ini
nul
